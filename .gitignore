# Environment variables file
.env

# Databases. Canonical lives outside this repo and is shipped to the server as
# an immutable artifact; this service only ever reads one. The trailing * also
# covers the -wal/-shm/-journal sidecars.
data/*.db*

# Go build outputs
*.exe
*.exe~
*.dll
*.so
*.dylib

# Output of go build
api_server
migrate_tool

# OS-specific files
.DS_Store
Thumbs.db

# Log files
logs/

# Migration script (local utility)
migrate.go


